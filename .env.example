# ============================================================
# SWASTHYAAI ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# Flask secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Local dev (SQLite):
DATABASE_URL=sqlite:///healthbot.db
# Production (Render PostgreSQL) — Render will set this automatically:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Models (optional — defaults shown)
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# Google OAuth (optional — leave blank to disable Google login)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Twilio SMS (optional — leave blank to disable SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Local dev only — allows OAuth over http://localhost
# DO NOT set this in production (Render uses HTTPS)
OAUTHLIB_INSECURE_TRANSPORT=1
